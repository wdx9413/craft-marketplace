{
  "description": "Resolve one bounded Knowledge, Memory, and Experience context receipt; automatically capture classified stable Memory facts and verified local signals.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member context", "timeout": 3, "statusMessage": "Checking Craft Context lifecycle" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member context", "timeout": 20, "additionalContextLimit": 400, "statusMessage": "Resolving scoped Craft Context" }, { "type": "command", "command": "node --experimental-strip-types \"${PLUGIN_ROOT}/runtime/craft-self-evolution/hook.mjs\"", "timeout": 3, "additionalContextLimit": 400, "statusMessage": "Resolving reusable self-evolution context" }] }],
    "PostToolUse": [{ "matcher": "Bash|^apply_patch$|Edit|Write", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member context", "timeout": 3, "statusMessage": "Recording verified Craft signals" }, { "type": "command", "command": "node --experimental-strip-types \"${PLUGIN_ROOT}/runtime/craft-self-evolution/hook.mjs\"", "timeout": 3, "statusMessage": "Recording self-evolution feedback" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member context", "timeout": 10, "statusMessage": "Closing Craft Context turn" }, { "type": "command", "command": "node --experimental-strip-types \"${PLUGIN_ROOT}/runtime/craft-self-evolution/hook.mjs\"", "timeout": 3, "statusMessage": "Closing self-evolution feedback" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member context", "timeout": 3, "statusMessage": "Closing Craft Context session" }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member context", "timeout": 5, "statusMessage": "Capturing Craft resume snapshot" }] }]
  }
}
